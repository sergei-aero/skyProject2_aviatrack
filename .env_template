# Application Settings
APP_NAME="Python Project"
APP_VERSION="1.0.0"
DEBUG=True
LOG_LEVEL=INFO

# API Keys (example)
API_KEY=your_api_key_here
SECRET_KEY=your_secret_key_here

# Database (example)
DATABASE_URL=sqlite:///data/database.db
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# File Paths
DATA_DIR=./data
REPORTS_DIR=./reports
LOGS_DIR=./logs

# Application Limits
PAGE_SIZE=50
MAX_FILE_SIZE_MB=10